PORT=3001
# Optional. Set a long random secret before exposing a public MCP endpoint.
# If set, Claude must send it as Authorization: Bearer <MCP_API_TOKEN>.
MCP_API_TOKEN=

# Supabase Backend Configuration (Cloud PostgreSQL + Realtime)
# When provided, MeetingPilot connects to your Supabase PostgreSQL database.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Local SQLite database path (used as fallback when Supabase is not configured)
DATABASE_PATH=./data/meetingpilot.db
