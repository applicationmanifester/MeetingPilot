PORT=3001
# Optional for the public evaluation demo. When set, Claude must send it as
# Authorization: Bearer <MCP_API_TOKEN>.
MCP_API_TOKEN=

# Supabase backend. Use a server-only secret key in hosted environments.
# Never put SUPABASE_SERVICE_ROLE_KEY in public browser code.
SUPABASE_URL=https://magysstkgdiyqvmfbjjc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# For local demo only: public key plus the demo's open RLS policies.
SUPABASE_KEY=

# Demo seeding is disabled by default and never clears existing data.
ENABLE_DEMO_SEED=false

# Local SQLite database path (used as fallback when Supabase is not configured)
DATABASE_PATH=./data/meetingpilot.db
